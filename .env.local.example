# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (used for OAuth callbacks, public form URLs, Polar redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (Chunk 4)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Clasd

# Polar (Chunk 6) — get these from polar.sh
# Use sandbox mode in dev: https://sandbox.polar.sh
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID_PRO=
# Set POLAR_SERVER=sandbox in dev, leave unset (or 'production') for live
POLAR_SERVER=sandbox

# Cron secret (Chunk 5 — optional in dev)
# CRON_SECRET=
